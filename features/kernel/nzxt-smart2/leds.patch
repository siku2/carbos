+/*
+ * The device sends this input report in response to "lighting info" command:
+ * a 2-byte output report { 0x20, 0x03 }.
+ */
+struct lighting_info_report {
+	/* report_id should be INPUT_REPORT_ID_LIGHTING_INFO = 0x21 */
+	u8 report_id;
+	/* Always 0x03 */
+	u8 magic;
+	u8 unknown[12];
+	u8 channel_count;
+	/* Accessory type per slot, 0 for an empty slot. */
+	u8 accessories[LED_CHANNELS_MAX][LED_ACCESSORIES_MAX];
+} __packed;
+
 #define OUTPUT_REPORT_SIZE 64
 
 enum {
+	OUTPUT_REPORT_ID_LIGHTING_INFO = 0x20,
+	OUTPUT_REPORT_ID_SET_LEDS = 0x2a,
 	OUTPUT_REPORT_ID_INIT_COMMAND = 0x60,
 	OUTPUT_REPORT_ID_SET_FAN_SPEED = 0x62,
 };
 
 enum {
+	LED_MODE_FIXED = 0x00,
+	LED_MODE_SPECTRUM_WAVE = 0x02,
+	LED_MODE_COVERING_MARQUEE = 0x04,
+	LED_MODE_PULSE = 0x06,
+	LED_MODE_BREATHING = 0x07,
+	LED_MODE_CANDLE = 0x08,
+	LED_MODE_STARRY_NIGHT = 0x09,
+	LED_MODE_RAINBOW_FLOW = 0x0b,
+	LED_MODE_SUPER_RAINBOW = 0x0c,
+	LED_MODE_RAINBOW_PULSE = 0x0d,
+};
+
+#define LED_SPEED_FIXED 0x32
+#define LED_DIRECTION_BACKWARD 0x02
+#define LED_FLAGS_FADE 0x08
+
+/*
+ * This output report sets the lighting mode for one or more LED channels.
+ * Older firmware used report 0x28 for this, which this firmware does not
+ * declare.
+ */
+struct set_leds_report {
+	/* report_id should be OUTPUT_REPORT_ID_SET_LEDS = 0x2a */
+	u8 report_id;
+	/* Should be 0x04 */
+	u8 magic;
+	u8 channel_bit_mask;
+	u8 channel_bit_mask_dup;
+	u8 mode;
+	/* Mode specific period, smaller is faster. */
+	__le16 speed;
+	/* Colors as G, R, B. */
+	u8 colors[16][3];
+	u8 direction;
+	u8 color_count;
+	u8 flags;
+	/* Should be { 0x08, 0x03 } */
+	u8 unknown[2];
+	u8 padding[4];
+} __packed;
+
