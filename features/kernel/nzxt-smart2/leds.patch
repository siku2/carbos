+static int nzxt_smart2_register_triggers(void)
+{
+	struct nzxt_smart2_effect *effect;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(nzxt_smart2_effects); i++) {
+		effect = &nzxt_smart2_effects[i];
+		if (effect->direction)
+			effect->trigger.groups = nzxt_smart2_direction_groups;
+		else if (effect->speed[0])
+			effect->trigger.groups = nzxt_smart2_speed_groups;
+
+		ret = led_trigger_register(&effect->trigger);
+		if (ret)
+			goto err;
+	}
+	return 0;
+
+err:
+	while (i--)
+		led_trigger_unregister(&nzxt_smart2_effects[i].trigger);
+	return ret;
+}
+
+static void nzxt_smart2_unregister_triggers(void)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(nzxt_smart2_effects); i++)
+		led_trigger_unregister(&nzxt_smart2_effects[i].trigger);
+}
+
+static void nzxt_smart2_leds_unregister(struct drvdata *drvdata)
+{
+	int i;
+
+	if (!drvdata->leds)
+		return;
+
+	for (i = 0; i < drvdata->led_channel_count; i++)
+		if (drvdata->leds[i].registered)
+			led_classdev_multicolor_unregister(&drvdata->leds[i].mc);
+}
+
+static void nzxt_smart2_leds_reapply(struct drvdata *drvdata)
+{
+	int i;
+
+	if (!drvdata->leds)
+		return;
+
+	guard(mutex)(&drvdata->mutex);
+	for (i = 0; i < drvdata->led_channel_count; i++)
+		if (drvdata->leds[i].registered)
+			nzxt_smart2_led_apply(&drvdata->leds[i]);
+}
+
+/*
+ * The hardware state is left alone until userspace sets it, so the LEDs keep
+ * what they showed before the driver loaded.
+ */
+static int nzxt_smart2_leds_init(struct drvdata *drvdata)
+{
+	static const u8 lighting_info_report[] = {
+		OUTPUT_REPORT_ID_LIGHTING_INFO,
+		0x03,
+	};
+	struct device *dev = &drvdata->hid->dev;
+	struct nzxt_smart2_led *led;
+	struct led_classdev *cdev;
+	int i, j, ret;
+
+	scoped_guard(mutex, &drvdata->mutex)
+		ret = send_output_report(drvdata, lighting_info_report,
+					 sizeof(lighting_info_report));
+	if (ret)
+		return ret;
+
+	if (!wait_for_completion_timeout(&drvdata->lighting_info_received,
+					 msecs_to_jiffies(LIGHTING_INFO_TIMEOUT_MS)))
+		return -ETIMEDOUT;
+
+	drvdata->leds = devm_kcalloc(dev, drvdata->led_channel_count,
+				     sizeof(*drvdata->leds), GFP_KERNEL);
+	if (!drvdata->leds)
+		return -ENOMEM;
+
+	for (i = 0; i < drvdata->led_channel_count; i++) {
+		if (!drvdata->led_accessory[i])
+			continue;
+
+		led = &drvdata->leds[i];
+		led->drvdata = drvdata;
+		led->channel = i;
+		led->speed = LED_SPEED_DEFAULT;
+
+		led->subleds[0].color_index = LED_COLOR_ID_RED;
+		led->subleds[1].color_index = LED_COLOR_ID_GREEN;
+		led->subleds[2].color_index = LED_COLOR_ID_BLUE;
+		for (j = 0; j < 3; j++) {
+			led->subleds[j].channel = j;
+			led->subleds[j].intensity = LED_FULL;
+		}
+		led->mc.subled_info = led->subleds;
+		led->mc.num_colors = 3;
+
+		cdev = &led->mc.led_cdev;
+		cdev->name = devm_kasprintf(dev, GFP_KERNEL, "%s:rgb:led-%d",
+					    dev_name(dev), i + 1);
+		if (!cdev->name) {
+			ret = -ENOMEM;
+			goto err;
+		}
+		cdev->max_brightness = LED_FULL;
+		cdev->brightness_set_blocking = nzxt_smart2_led_brightness_set;
+		cdev->trigger_type = &nzxt_smart2_trigger_type;
+		cdev->flags = LED_RETAIN_AT_SHUTDOWN;
+
+		ret = led_classdev_multicolor_register(dev, &led->mc);
+		if (ret)
+			goto err;
+		led->registered = true;
+	}
+	return 0;
+
+err:
+	nzxt_smart2_leds_unregister(drvdata);
+	drvdata->leds = NULL;
+	return ret;
+}
