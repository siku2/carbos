+static void handle_lighting_info_report(struct drvdata *drvdata, void *data,
+					int size)
+{
+	struct lighting_info_report *report = data;
+	int i;
+
+	if (size < sizeof(struct lighting_info_report))
+		return;
+
+	if (report->magic != 0x03 || completion_done(&drvdata->lighting_info_received))
+		return;
+
+	drvdata->led_channel_count = min_t(u8, report->channel_count,
+					   LED_CHANNELS_MAX);
+	for (i = 0; i < drvdata->led_channel_count; i++)
+		drvdata->led_accessory[i] = report->accessories[i][0];
+
+	complete(&drvdata->lighting_info_received);
+}
+
+static struct nzxt_smart2_led *to_nzxt_smart2_led(struct led_classdev *cdev)
+{
+	return container_of(lcdev_to_mccdev(cdev), struct nzxt_smart2_led, mc);
+}
+
+static int nzxt_smart2_led_apply(struct nzxt_smart2_led *led)
+{
+	const struct nzxt_smart2_effect *effect = led->effect;
+	unsigned int brightness = led->mc.led_cdev.brightness;
+	struct set_leds_report report = {
+		.report_id = OUTPUT_REPORT_ID_SET_LEDS,
+		.magic = 0x04,
+		.channel_bit_mask = 1 << led->channel,
+		.channel_bit_mask_dup = 1 << led->channel,
+		.mode = LED_MODE_FIXED,
+		.color_count = 1,
+		.unknown = { 0x08, 0x03 },
+	};
+
+	lockdep_assert_held(&led->drvdata->mutex);
+
+	if (brightness) {
+		report.speed = cpu_to_le16(LED_SPEED_FIXED);
+		if (effect) {
+			report.mode = effect->mode;
+			report.flags = effect->flags;
+			if (effect->speed[0])
+				report.speed = cpu_to_le16(effect->speed[led->speed]);
+			if (effect->direction && led->reverse)
+				report.direction = LED_DIRECTION_BACKWARD;
+		}
+		if (!effect || effect->color) {
+			led_mc_calc_color_components(&led->mc, brightness);
+			report.colors[0][0] = led->subleds[1].brightness;
+			report.colors[0][1] = led->subleds[0].brightness;
+			report.colors[0][2] = led->subleds[2].brightness;
+		}
+	}
+
+	return send_output_report(led->drvdata, &report, sizeof(report));
+}
+
+static int nzxt_smart2_led_brightness_set(struct led_classdev *cdev,
+					  enum led_brightness brightness)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(cdev);
+
+	guard(mutex)(&led->drvdata->mutex);
+	return nzxt_smart2_led_apply(led);
+}
+
+static int nzxt_smart2_trigger_activate(struct led_classdev *cdev)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(cdev);
+
+	guard(mutex)(&led->drvdata->mutex);
+	led->effect = container_of(cdev->trigger, struct nzxt_smart2_effect,
+				   trigger);
+	if (!cdev->brightness)
+		cdev->brightness = cdev->max_brightness;
+	return nzxt_smart2_led_apply(led);
+}
+
+/* The LED core turns the LED off after this, which writes the hardware. */
+static void nzxt_smart2_trigger_deactivate(struct led_classdev *cdev)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(cdev);
+
+	guard(mutex)(&led->drvdata->mutex);
+	led->effect = NULL;
+}
+
+static ssize_t speed_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(led_trigger_get_led(dev));
+
+	return sysfs_emit(buf, "%u\n", led->speed);
+}
+
+static ssize_t speed_store(struct device *dev, struct device_attribute *attr,
+			   const char *buf, size_t count)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(led_trigger_get_led(dev));
+	u8 speed;
+	int ret;
+
+	ret = kstrtou8(buf, 10, &speed);
+	if (ret)
+		return ret;
+	if (speed >= LED_SPEED_COUNT)
+		return -EINVAL;
+
+	guard(mutex)(&led->drvdata->mutex);
+	led->speed = speed;
+	ret = nzxt_smart2_led_apply(led);
+	return ret ?: count;
+}
+static DEVICE_ATTR_RW(speed);
+
+static ssize_t direction_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(led_trigger_get_led(dev));
+
+	return sysfs_emit(buf, "%s\n", led->reverse ? "reverse" : "forward");
+}
+
+static ssize_t direction_store(struct device *dev,
+			       struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	struct nzxt_smart2_led *led = to_nzxt_smart2_led(led_trigger_get_led(dev));
+	bool reverse;
+	int ret;
+
+	if (sysfs_streq(buf, "forward"))
+		reverse = false;
+	else if (sysfs_streq(buf, "reverse"))
+		reverse = true;
+	else
+		return -EINVAL;
+
+	guard(mutex)(&led->drvdata->mutex);
+	led->reverse = reverse;
+	ret = nzxt_smart2_led_apply(led);
+	return ret ?: count;
+}
