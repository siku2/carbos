-module_hid_driver(hidpp_driver);
+static int __init hidpp_init(void)
+{
+	int ret;
+
+	ret = hidpp_led_triggers_register();
+	if (ret)
+		return ret;
+	ret = hid_register_driver(&hidpp_driver);
+	if (ret)
+		hidpp_led_triggers_unregister();
+	return ret;
+}
+module_init(hidpp_init);
+
+static void __exit hidpp_exit(void)
+{
+	hid_unregister_driver(&hidpp_driver);
+	hidpp_led_triggers_unregister();
+}
+module_exit(hidpp_exit);
