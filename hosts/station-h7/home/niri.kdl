// Samsung Odyssey G95NC, 7680x2160 at 240 Hz.
//
// This is included before the dms fragments on purpose. niri keeps every
// output block it parses and then uses the first one that matches, so the
// dms display panel would win if it ever wrote dms/outputs.kdl.
output "DP-4" {
    mode "7680x2160@240.000"
    variable-refresh-rate on-demand=true
}

layout {
    // A quarter of 7680 is 1920, a half is a 16:9 3840x2160 and three
    // quarters is 24:9.
    preset-column-widths {
        proportion 0.25
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 0.75
    }
    default-column-width { proportion 0.33333; }
}

// Half the screen is exactly 16:9, which leaves a quarter on either side for
// chat, music and a browser. Mod+R widens a 24:9 title to three quarters.
window-rule {
    match app-id=r#"^gamescope$"#
    match app-id=r#"^steam_app_\d+$"#
    default-column-width { proportion 0.5; }
    variable-refresh-rate true
    open-fullscreen false
}
