// Named by edid, not connector: MST retrains renumber DP-N (DP-4 to DP-5
// here already). Included first because niri takes the first matching
// output block, and dms/outputs.kdl would otherwise win.
output "Samsung Electric Company Odyssey G95NC HNTL300403" {
    mode "7680x2160@240.000"
    variable-refresh-rate on-demand=true
}

layout {
    // Half of 7680 is a 16:9 3840x2160, three quarters is 24:9.
    preset-column-widths {
        proportion 0.125
        proportion 0.25
        proportion 0.5
        proportion 0.75
    }
    default-column-width { proportion 0.25; }
}

window-rule {
    match app-id=r#"^gamescope$"#
    match app-id=r#"^steam_app_\d+$"#
    default-column-width { proportion 0.5; }
    variable-refresh-rate true
    open-fullscreen false
}

window-rule {
    match app-id=r#"^steam$"# title=r#"^Friends List$"#
    match app-id=r#"^firefox$"# title=r#"^Extension: \(Bitwarden Password Manager\)"#
    match app-id=r#"^plexamp$"#
    default-column-width { proportion 0.125; }
}
