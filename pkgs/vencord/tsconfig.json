{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["node"],
    "jsx": "preserve",

    // Vencord's API has const enums like OptionType. esbuild inlines them.
    "isolatedModules": false,
    "verbatimModuleSyntax": false,

    "paths": {
      "@api/*": ["./.vencord-types/api/*"],
      "@components/*": ["./.vencord-types/components/*"],
      "@plugins/*": ["./.vencord-types/plugins/*"],
      "@shared/*": ["./.vencord-types/shared/*"],
      "@utils/*": ["./.vencord-types/utils/*"],
      "@webpack": ["./.vencord-types/webpack/webpack"],
      "@webpack/common": ["./.vencord-types/webpack/common"],
      "@webpack/common/*": ["./.vencord-types/webpack/common/*"],
      "@webpack/patcher": ["./.vencord-types/webpack/patchWebpack"],
      "@webpack/types": ["./.vencord-types/webpack/types"]
    }
  },
  "include": ["packages", "plugins", ".vencord-types/globals.d.ts"]
}
